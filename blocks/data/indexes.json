    { "schema": "ReorderSetting", "fields": "productId,locationId", "unique": true },
    { "schema": "ReorderSuggestion", "fields": "productId,locationId", "unique": true },
    { "schema": "DailySalesSummary", "fields": "summaryKey", "unique": true },
